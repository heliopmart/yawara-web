{
  "compilerOptions": {
    "declaration": true,
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",   
    "rootDir": "./src",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "dist/**", "*.tsbuildinfo"]
}
